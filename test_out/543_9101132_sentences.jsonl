[{"md5":"db2a78bf4d7ecbc818f6951147a15f49","id":0,"text":"A noun is a kind of word (see part of speech) that is usually the name of something such as a person, place, thing, animal, or idea.","startIdx":74104,"endIdx":74797,"section":"Lead","locList":[{"start":74103,"end":74104},{"start":74107,"end":74109},{"start":74112,"end":74116},{"start":74120,"end":74134},{"start":74168,"end":74172},{"start":74176,"end":74182},{"start":74256,"end":74270},{"start":74274,"end":74296},{"start":74330,"end":74334},{"start":74338,"end":74362},{"start":74420,"end":74426},{"start":74430,"end":74432},{"start":74541,"end":74546},{"start":74550,"end":74552},{"start":74689,"end":74694},{"start":74698,"end":74700},{"start":74738,"end":74744},{"start":74748,"end":74753},{"start":74787,"end":74791},{"start":74795,"end":74796}]},{"md5":"446194c70fc429f18412b89fffb02c64","id":1,"text":"In English, nouns can be singular or plural.","startIdx":74798,"endIdx":74992,"section":"Lead","locList":[{"start":74796,"end":74800},{"start":74858,"end":74865},{"start":74869,"end":74884},{"start":74926,"end":74934},{"start":74938,"end":74942},{"start":74980,"end":74986},{"start":74990,"end":74991}]},{"md5":"02e80d3dc3cecb67530f25e46eb31ac6","id":2,"text":"Nouns often need a word called an article or determiner (like the or that).","startIdx":74993,"endIdx":75244,"section":"Lead","locList":[{"start":74991,"end":74992},{"start":74999,"end":75033},{"start":75093,"end":75100},{"start":75104,"end":75108},{"start":75195,"end":75205},{"start":75209,"end":75216},{"start":75219,"end":75222},{"start":75226,"end":75230},{"start":75233,"end":75237},{"start":75241,"end":75243}]},{"md5":"b42672cfeec7a320560143e0720303a6","id":3,"text":"These words usually do not go with other kinds of words like verbs or adverbs.","startIdx":75245,"endIdx":75403,"section":"Lead","locList":[{"start":75243,"end":75305},{"start":75339,"end":75344},{"start":75348,"end":75352},{"start":75390,"end":75397},{"start":75401,"end":75402}]},{"md5":"34a4cc3a6312cfb016b3e8377a743eb9","id":4,"text":"(For example, people do not also describe nouns).","startIdx":75404,"endIdx":75453,"section":"Lead","locList":[{"start":75402,"end":75452}]},{"md5":"2ee6549f7bf5d76f8a307dce768937f1","id":5,"text":"In English, there are more nouns than any other kind of word.","startIdx":75454,"endIdx":75515,"section":"Lead","locList":[{"start":75452,"end":75514}]},{"md5":"59f9a90f5470e5bc9722a8de296f2e9e","id":6,"text":"Every language in the world has nouns, but they are not always used in the same ways.","startIdx":75516,"endIdx":75608,"section":"Lead","locList":[{"start":75514,"end":75515},{"start":75522,"end":75607}]},{"md5":"88b944c1cfec53871496ab30cb642692","id":7,"text":"They also can have different properties in different languages.","startIdx":75609,"endIdx":75672,"section":"Lead","locList":[{"start":75607,"end":75671}]},{"md5":"3ae8759ad3b5be826533fc0dc8a6cf42","id":8,"text":"In some other languages, nouns do not change for singular and plural, and sometimes there is no word for the.","startIdx":75673,"endIdx":75789,"section":"Lead","locList":[{"start":75671,"end":75777},{"start":75780,"end":75783},{"start":75787,"end":75788}]},{"md5":"de4c3ac420b45ee08daf357d15849e71","id":9,"text":"Examples of nouns: time, people, way, year, government, day, world, life, work, part, number, house, system, company, end, party, information.","startIdx":75790,"endIdx":75946,"section":"Lead","locList":[{"start":75788,"end":75789},{"start":75796,"end":75815},{"start":75818,"end":75940},{"start":75944,"end":75945}]},{"md5":"ee884c499dafb5a7d65fb6e49ccc5887","id":10,"text":"The word noun comes from the Latin nomen meaning \"name.\"","startIdx":76050,"endIdx":76202,"section":"Lead","locList":[{"start":76049,"end":76050},{"start":76053,"end":76062},{"start":76065,"end":76069},{"start":76073,"end":76089},{"start":76125,"end":76130},{"start":76134,"end":76135},{"start":76138,"end":76143},{"start":76147,"end":76157},{"start":76191,"end":76195},{"start":76199,"end":76201}]},{"md5":"883560480a3d9d4b91139f9106ec9e8a","id":11,"text":"Words like nouns were described in early days by the Sanskrit grammarian Pāṇini and ancient Greeks like Dionysios Thrax.","startIdx":76203,"endIdx":76598,"section":"Lead","locList":[{"start":76201,"end":76255},{"start":76297,"end":76305},{"start":76309,"end":76321},{"start":76413,"end":76419},{"start":76423,"end":76448},{"start":76577,"end":76592},{"start":76596,"end":76597}]},{"md5":"8e0c85f23729a3eaaa56af3c272192b5","id":12,"text":"Also in ancient Tamil like \"Peyarchol\"","startIdx":76599,"endIdx":76637,"section":"Lead","locList":[{"start":76597,"end":76636}]},{"md5":"3dac75a3d9a796390d15f065ece5f859","id":13,"text":"In English sentences, nouns can be used as a subject, object, or complement.","startIdx":76717,"endIdx":77120,"section":"Lead","locList":[{"start":76716,"end":76717},{"start":76720,"end":76731},{"start":76773,"end":76782},{"start":76786,"end":76811},{"start":76871,"end":76878},{"start":76882,"end":76884},{"start":76942,"end":76948},{"start":76952,"end":76957},{"start":77104,"end":77114},{"start":77118,"end":77119}]},{"md5":"7ed7c6d73263f9fb75f6b9077ac3e317","id":14,"text":"They often come after prepositions, as the 'object of preposition'.","startIdx":77121,"endIdx":77240,"section":"Lead","locList":[{"start":77119,"end":77142},{"start":77190,"end":77202},{"start":77206,"end":77239}]},{"md5":"3cf69921e34a139b3cf971c717166cfa","id":15,"text":"Nouns can sometimes describe other nouns (such as a soccer ball).","startIdx":77241,"endIdx":77320,"section":"Lead","locList":[{"start":77239,"end":77240},{"start":77247,"end":77299},{"start":77302,"end":77308},{"start":77312,"end":77319}]},{"md5":"99a3b771e3783b2d02040899c7e8f40f","id":16,"text":"When they do this, they are called modifiers or adjuncts.","startIdx":77321,"endIdx":77497,"section":"Lead","locList":[{"start":77319,"end":77355},{"start":77470,"end":77479},{"start":77483,"end":77496}]},{"md5":"8603450ac14218fed0184a53a609a0f4","id":17,"text":"There are also verb forms that can be used in the same way as nouns (such as 'I like running.') These are called verbals or verbal nouns, and include participles (which can also be adjectives) and infinitives.","startIdx":77498,"endIdx":77888,"section":"Lead","locList":[{"start":77496,"end":77497},{"start":77504,"end":77519},{"start":77553,"end":77557},{"start":77561,"end":77627},{"start":77630,"end":77637},{"start":77641,"end":77663},{"start":77666,"end":77673},{"start":77677,"end":77681},{"start":77684,"end":77696},{"start":77700,"end":77714},{"start":77763,"end":77774},{"start":77782,"end":77818},{"start":77867,"end":77878},{"start":77886,"end":77887}]},{"md5":"462d1826c37024915631b3460bd62db5","id":18,"text":"Nouns are classified into common and proper.","startIdx":77889,"endIdx":77954,"section":"Lead","locList":[{"start":77887,"end":77888},{"start":77895,"end":77921},{"start":77924,"end":77930},{"start":77934,"end":77939},{"start":77942,"end":77948},{"start":77952,"end":77953}]},{"md5":"d55c22c3f8e9c2b1256255a904ef111c","id":19,"text":"Pronouns have commonly been considered a different part of speech from nouns, but in the past some grammars have included them as nouns[1] as do many modern linguists.[2]","startIdx":77955,"endIdx":78381,"section":"Lead","locList":[{"start":77953,"end":77954},{"start":77994,"end":78002},{"start":78006,"end":78133},{"start":78195,"end":78206},{"start":78216,"end":78235},{"start":78283,"end":78292},{"start":78296,"end":78297},{"start":78359,"end":78370}]},{"md5":"72d8358ee61d7a3d6c6dbf2401cac185","id":20,"text":"Proper nouns (also called proper name) are specific names.","startIdx":78459,"endIdx":78535,"section":"Lead","locList":[{"start":78458,"end":78459},{"start":78465,"end":78477},{"start":78481,"end":78495},{"start":78498,"end":78509},{"start":78513,"end":78534}]},{"md5":"17d2a65fbc22fd7220699efd2bef51a5","id":21,"text":"Examples of proper nouns are: London, John, God, October, Mozart, Saturday, Coke, Mr. Brown, Atlantic Ocean. Proper nouns are individual things with names, not general nouns.","startIdx":78536,"endIdx":78717,"section":"Lead","locList":[{"start":78534,"end":78565},{"start":78568,"end":78646},{"start":78650,"end":78716}]},{"md5":"a985b166dba83205782a49c396c2a204","id":22,"text":"Proper nouns begin with an upper case (capital) letter in English and many other languages that use the Roman alphabet.","startIdx":78718,"endIdx":79151,"section":"Lead","locList":[{"start":78716,"end":78717},{"start":78724,"end":78751},{"start":78846,"end":78856},{"start":78860,"end":78862},{"start":78926,"end":78933},{"start":78937,"end":78949},{"start":79007,"end":79014},{"start":79018,"end":79057},{"start":79131,"end":79145},{"start":79149,"end":79150}]},{"md5":"4c97c2e5b159b09d8405dc570e4e6eda","id":23,"text":"(However, in German, all nouns begin with an upper case letter.) The word \"I\" is really a pronoun, although it is capitalized in English, like a proper noun.","startIdx":79153,"endIdx":79371,"section":"Lead","locList":[{"start":79150,"end":79165},{"start":79221,"end":79227},{"start":79231,"end":79369}]},{"md5":"9eac1b2fb39086894b9abf0969c2ee22","id":24,"text":"Some common nouns (see below) can also be used as proper nouns.","startIdx":79372,"endIdx":79441,"section":"Lead","locList":[{"start":79369,"end":79370},{"start":79377,"end":79440}]},{"md5":"b56c314b0b1743189da1c8dc8b736349","id":25,"text":"For example, someone might be named \"Tiger Smith\" -- even though he is not a tiger or a smith.","startIdx":79442,"endIdx":79640,"section":"Lead","locList":[{"start":79440,"end":79518},{"start":79554,"end":79559},{"start":79563,"end":79569},{"start":79629,"end":79634},{"start":79638,"end":79639}]},{"md5":"d4a8258b13371e8f4e1ee375fea08d44","id":26,"text":"Common nouns are general names.","startIdx":79718,"endIdx":79760,"section":"Lead","locList":[{"start":79717,"end":79718},{"start":79724,"end":79736},{"start":79740,"end":79759}]},{"md5":"f6c4e323eac79fc8cf5cb71d63073c1c","id":27,"text":"Sometimes the same word can be either a common noun or a proper noun, depending on how it is used; for example:","startIdx":79761,"endIdx":79872,"section":"Lead","locList":[{"start":79759,"end":79871}]},{"md5":"e0dc4be221483caed9a284c93203eb55","id":28,"text":"there can be many gods, but there is only one God.","startIdx":79877,"endIdx":80049,"section":"Lead","locList":[{"start":79876,"end":79877},{"start":79885,"end":79903},{"start":79960,"end":79964},{"start":79972,"end":79996},{"start":80031,"end":80034},{"start":80042,"end":80043}]},{"md5":"65a75900d3ae7d7640e2b8d213a72cba","id":29,"text":"there can be many internets (two or more networks connected together), but the largest internet in the world is the Internet.","startIdx":80050,"endIdx":80249,"section":"Lead","locList":[{"start":80048,"end":80049},{"start":80053,"end":80071},{"start":80074,"end":80083},{"start":80087,"end":80176},{"start":80221,"end":80229},{"start":80237,"end":80238}]},{"md5":"0754f6131c6d00defcc838743e3ef462","id":30,"text":"In English and many other languages, nouns have 'number'.","startIdx":80322,"endIdx":80383,"section":"Lead","locList":[{"start":80321,"end":80322},{"start":80325,"end":80382}]},{"md5":"c6b509f63b680de644792fb6c3d6ada6","id":31,"text":"But some nouns are only singular (such as furniture, physics) and others are only plural (such as clothes, police).","startIdx":80384,"endIdx":80615,"section":"Lead","locList":[{"start":80382,"end":80407},{"start":80452,"end":80460},{"start":80468,"end":80478},{"start":80481,"end":80499},{"start":80503,"end":80525},{"start":80566,"end":80572},{"start":80580,"end":80590},{"start":80593,"end":80608},{"start":80612,"end":80614}]},{"md5":"e4d6e086429b5661f392437d9a506e2b","id":32,"text":"Also, some nouns are countable (for example, one piece, two pieces) but others are uncountable (for example, we do not say one furniture, two furnitures).","startIdx":80616,"endIdx":80798,"section":"Lead","locList":[{"start":80614,"end":80636},{"start":80639,"end":80648},{"start":80652,"end":80667},{"start":80670,"end":80691},{"start":80695,"end":80712},{"start":80715,"end":80726},{"start":80730,"end":80759},{"start":80762,"end":80791},{"start":80795,"end":80797}]},{"md5":"7d033f76a820158dfc3bd1c21c2ac56e","id":33,"text":"The plural form of most nouns is created simply by adding the letter(s) -(e)s.","startIdx":80799,"endIdx":80891,"section":"Lead","locList":[{"start":80797,"end":80798},{"start":80805,"end":80877},{"start":80880,"end":80886}]},{"md5":"88fd0e13c10cd1a63e899de6ed80dd9c","id":34,"text":"more than one snake = snakes","startIdx":80896,"endIdx":80938,"section":"Lead","locList":[{"start":80895,"end":80896},{"start":80904,"end":80932}]},{"md5":"249327784ab05b0aa6b13478d2986d93","id":35,"text":"more than one ski = skis","startIdx":80939,"endIdx":80972,"section":"Lead","locList":[{"start":80937,"end":80938},{"start":80942,"end":80966}]},{"md5":"e8471ad70e875b0a979dd4e24afbfc15","id":36,"text":"more than one Barrymore = Barrymores","startIdx":80973,"endIdx":81023,"section":"Lead","locList":[{"start":80971,"end":80972},{"start":80976,"end":81012}]},{"md5":"06442b35b8ef89a60fa1557536a52125","id":37,"text":"Despite plural forms being written using the letter(s) -(e)s, the pronunciation of the letter(s) will pronounced as /-s/, /-z/, or /-ız/ depending on which type of phoneme, or unique sound, comes before it.","startIdx":81024,"endIdx":81340,"section":"Lead","locList":[{"start":81022,"end":81023},{"start":81026,"end":81081},{"start":81084,"end":81089},{"start":81093,"end":81099},{"start":81151,"end":81164},{"start":81168,"end":81253},{"start":81293,"end":81300},{"start":81304,"end":81339}]},{"md5":"fb02d4b7f996f9b0c1013932e48dca6e","id":38,"text":"These variations of the plural morpheme are called allomorphs.","startIdx":81341,"endIdx":81495,"section":"Lead","locList":[{"start":81339,"end":81371},{"start":81413,"end":81421},{"start":81425,"end":81437},{"start":81479,"end":81489},{"start":81493,"end":81494}]},{"md5":"e9df31f60968fafa9a3939837229a02a","id":39,"text":"Some dictionaries list \"busses\" as an acceptable plural for \"bus\".","startIdx":81496,"endIdx":81569,"section":"Lead","locList":[{"start":81494,"end":81495},{"start":81502,"end":81568}]},{"md5":"0ef6c2fef78cbab6932bb20ce61f551a","id":40,"text":"Presumably, this is because the plural \"buses\" looks like it ought to rhyme with the plural of \"fuse,\" which is \"fuses.\"","startIdx":81570,"endIdx":81690,"section":"Lead","locList":[{"start":81568,"end":81689}]},{"md5":"c3f0419838d8cfa6ba2fb8dfa79734bf","id":41,"text":"\"Buses\" is still listed as the preferable plural form.","startIdx":81691,"endIdx":81745,"section":"Lead","locList":[{"start":81689,"end":81744}]},{"md5":"f627c60b41a2fe882a154b078daf29e0","id":42,"text":"\"Busses\" is the plural for \"buss,\" a seldom used word for \"kiss.\"","startIdx":81746,"endIdx":81811,"section":"Lead","locList":[{"start":81744,"end":81810}]},{"md5":"da355bddc55cec7b2377293ff122704b","id":43,"text":"There are several nouns that have irregular plural forms.","startIdx":81812,"endIdx":81876,"section":"Lead","locList":[{"start":81810,"end":81811},{"start":81818,"end":81875}]},{"md5":"06bbcd188431fb6a604ab2d01a601124","id":44,"text":"Plurals formed in this way are sometimes called mutated (or mutating) plurals.","startIdx":81877,"endIdx":81962,"section":"Lead","locList":[{"start":81875,"end":81924},{"start":81927,"end":81956},{"start":81960,"end":81961}]},{"md5":"985738b6b87a1ca57d1a756938aa615d","id":45,"text":"more than one child = children","startIdx":81967,"endIdx":82011,"section":"Lead","locList":[{"start":81966,"end":81967},{"start":81975,"end":82005}]},{"md5":"a033a3dbbb4d754b8bc80b0b1bd51192","id":46,"text":"more than one woman = women","startIdx":82012,"endIdx":82048,"section":"Lead","locList":[{"start":82010,"end":82011},{"start":82015,"end":82042}]},{"md5":"3eefccbdeec718bf8a757d84afa837da","id":47,"text":"more than one man = men","startIdx":82049,"endIdx":82081,"section":"Lead","locList":[{"start":82047,"end":82048},{"start":82052,"end":82075}]},{"md5":"3c4fe5628e43ed622afb86735148f211","id":48,"text":"more than one person = people","startIdx":82082,"endIdx":82120,"section":"Lead","locList":[{"start":82080,"end":82081},{"start":82085,"end":82114}]},{"md5":"a4d8c0578646441bc099947ba95dd4c9","id":49,"text":"more than one goose = geese","startIdx":82121,"endIdx":82157,"section":"Lead","locList":[{"start":82119,"end":82120},{"start":82124,"end":82151}]},{"md5":"1e620f3c8b7bc87ec1ba46ca5ffe2920","id":50,"text":"more than one mouse = mice","startIdx":82158,"endIdx":82193,"section":"Lead","locList":[{"start":82156,"end":82157},{"start":82161,"end":82187}]},{"md5":"1b6f27c9b145624437cca53575a385d3","id":51,"text":"more than one deer = deer","startIdx":82194,"endIdx":82228,"section":"Lead","locList":[{"start":82192,"end":82193},{"start":82197,"end":82222}]},{"md5":"c2e44e12ff33a31b6ed47b28ab59aabb","id":52,"text":"more than one ox = oxen","startIdx":82229,"endIdx":82261,"section":"Lead","locList":[{"start":82227,"end":82228},{"start":82232,"end":82255}]},{"md5":"74169427092fb90fc0b8fe545f2c486e","id":53,"text":"more than one tooth = teeth","startIdx":82262,"endIdx":82303,"section":"Lead","locList":[{"start":82260,"end":82261},{"start":82265,"end":82292}]},{"md5":"5eff458ccc3df5671477c674d9e82dc5","id":54,"text":"Many of the above irregular plural forms stem from Old English, which had more complex rules for making plural forms.","startIdx":82304,"endIdx":82476,"section":"Lead","locList":[{"start":82302,"end":82303},{"start":82306,"end":82357},{"start":82405,"end":82416},{"start":82420,"end":82475}]},{"md5":"241035ad2ac86087049d7305daddfe9e","id":55,"text":"And, finally, there are nouns that maintain their Latin or Greek form in the plural.","startIdx":82477,"endIdx":82568,"section":"Lead","locList":[{"start":82475,"end":82476},{"start":82483,"end":82567}]},{"md5":"2768c46bc3bd3854fe6f560c31e6de9f","id":56,"text":"more than one nucleus = nuclei","startIdx":82574,"endIdx":82618,"section":"Lead","locList":[{"start":82573,"end":82574},{"start":82582,"end":82612}]},{"md5":"239b704dc02043e718b110e52f3001a9","id":57,"text":"more than one syllabus = syllabi","startIdx":82619,"endIdx":82660,"section":"Lead","locList":[{"start":82617,"end":82618},{"start":82622,"end":82654}]},{"md5":"0342f2d49c6cb718f3162f5d83475d21","id":58,"text":"more than one focus = foci","startIdx":82661,"endIdx":82696,"section":"Lead","locList":[{"start":82659,"end":82660},{"start":82664,"end":82690}]},{"md5":"7ba076ed0d51f128c36c73862645ad5b","id":59,"text":"more than one fungus = fungi","startIdx":82697,"endIdx":82734,"section":"Lead","locList":[{"start":82695,"end":82696},{"start":82700,"end":82728}]},{"md5":"f84acc892cc6f29b3bf8e0db835221cd","id":60,"text":"more than one cactus = cacti (cactuses is acceptable)","startIdx":82735,"endIdx":82804,"section":"Lead","locList":[{"start":82733,"end":82734},{"start":82738,"end":82768},{"start":82771,"end":82779},{"start":82783,"end":82798}]},{"md5":"79451d62bfee07debee220540c8f0a4e","id":61,"text":"more than one thesis = theses","startIdx":82805,"endIdx":82843,"section":"Lead","locList":[{"start":82803,"end":82804},{"start":82808,"end":82837}]},{"md5":"a6da129d7a6226cba64dcba807247a7c","id":62,"text":"more than one crisis = crises","startIdx":82844,"endIdx":82882,"section":"Lead","locList":[{"start":82842,"end":82843},{"start":82847,"end":82876}]},{"md5":"972a135198ff6019b87a7ef80b414c03","id":63,"text":"more than one phenomenon = phenomena","startIdx":82883,"endIdx":82928,"section":"Lead","locList":[{"start":82881,"end":82882},{"start":82886,"end":82922}]},{"md5":"4eea0b5268de788097e8c946c4c4e12a","id":64,"text":"more than one index = indices (indexes is acceptable)","startIdx":82929,"endIdx":82998,"section":"Lead","locList":[{"start":82927,"end":82928},{"start":82932,"end":82963},{"start":82966,"end":82973},{"start":82977,"end":82992}]},{"md5":"aa40ed9114fc3b4a27365695b5e73ab7","id":65,"text":"more than one appendix = appendices (appendixes is acceptable)","startIdx":82999,"endIdx":83077,"section":"Lead","locList":[{"start":82997,"end":82998},{"start":83002,"end":83039},{"start":83042,"end":83052},{"start":83056,"end":83071}]},{"md5":"c69be49726904fca71f322ae1462bd80","id":66,"text":"more than one criterion = criteria","startIdx":83078,"endIdx":83121,"section":"Lead","locList":[{"start":83076,"end":83077},{"start":83081,"end":83115}]},{"md5":"319c39d52a85e214c1ed44093609ee92","id":67,"text":"more than one octopus = octopedes is correct (as the word is Greek: ὀκτώποδες).","startIdx":83122,"endIdx":83286,"section":"Lead","locList":[{"start":83120,"end":83121},{"start":83125,"end":83186},{"start":83240,"end":83245},{"start":83249,"end":83251},{"start":83267,"end":83276},{"start":83283,"end":83285}]},{"md5":"f1b2fd2e62231836315ad3db23e3ff33","id":68,"text":"However, octopuses is acceptable, more used and simpler.","startIdx":83287,"endIdx":83353,"section":"Lead","locList":[{"start":83285,"end":83342}]},{"md5":"6ddf6b081a152765029eed7e4aa27664","id":69,"text":"Nouns are words for things, and since things can be possessed, nouns can also change to show possession in grammar.","startIdx":83424,"endIdx":83543,"section":"Lead","locList":[{"start":83423,"end":83424},{"start":83427,"end":83542}]},{"md5":"81cbf6e1164ee0ef9b1d0d4a182ee6bd","id":70,"text":"In English, we usually add an apostrophe and an s to nouns to make them possessive, or sometimes just an apostrophe when there is already an s at the end, like this:","startIdx":83544,"endIdx":83780,"section":"Lead","locList":[{"start":83542,"end":83573},{"start":83619,"end":83629},{"start":83633,"end":83641},{"start":83644,"end":83645},{"start":83649,"end":83672},{"start":83675,"end":83685},{"start":83689,"end":83748},{"start":83751,"end":83752},{"start":83756,"end":83779}]},{"md5":"50f9e1d467d89a869885075515f0eeb3","id":71,"text":"This is Sam.","startIdx":83785,"endIdx":83806,"section":"Lead","locList":[{"start":83784,"end":83785},{"start":83793,"end":83805}]},{"md5":"ccdae9526fba46689e0593c17fa5b37d","id":72,"text":"This is Sam's cat.","startIdx":83807,"endIdx":83837,"section":"Lead","locList":[{"start":83805,"end":83814},{"start":83817,"end":83822},{"start":83826,"end":83831}]},{"md5":"54a02310ec5d97247546590eed4fc8b9","id":73,"text":"The woman's hair is long.","startIdx":83838,"endIdx":83879,"section":"Lead","locList":[{"start":83836,"end":83837},{"start":83841,"end":83845},{"start":83848,"end":83855},{"start":83859,"end":83873}]},{"md5":"71cbade4322cdc6b62998228bfa15ea4","id":74,"text":"There are three cats.","startIdx":83880,"endIdx":83905,"section":"Lead","locList":[{"start":83878,"end":83879},{"start":83883,"end":83904}]},{"md5":"b4b656141c27be8284844969915875ec","id":75,"text":"The cats' mother is sleeping.","startIdx":83906,"endIdx":84012,"section":"Lead","locList":[{"start":83904,"end":83909},{"start":83912,"end":83916},{"start":83965,"end":83970},{"start":83981,"end":84001}]},{"md5":"35f2b07ec8557578744aa522501e71f7","id":76,"text":"Most adjectives become nouns by adding the suffix -ness.","startIdx":84115,"endIdx":84224,"section":"Lead","locList":[{"start":84114,"end":84115},{"start":84118,"end":84161},{"start":84199,"end":84205},{"start":84209,"end":84211},{"start":84214,"end":84218},{"start":84222,"end":84223}]},{"md5":"368e9b9f9d5ffc5ac5bb121ea866a625","id":77,"text":"Example: Take the adjective 'natural', add 'ness' to get 'naturalness', a noun.","startIdx":84225,"endIdx":84304,"section":"Lead","locList":[{"start":84223,"end":84303}]},{"md5":"45bd318e12e35f7fd61a1299dc292c86","id":78,"text":"To see a list of 100 adjectives used in Basic English, click here.","startIdx":84305,"endIdx":84512,"section":"Lead","locList":[{"start":84303,"end":84344},{"start":84396,"end":84409},{"start":84413,"end":84415},{"start":84496,"end":84506},{"start":84510,"end":84511}]},{"md5":"5bb8f3d5b3a9aaa5a3d042abd71e43ab","id":79,"text":"A noun phrase is a phrase where the head word is a noun.","startIdx":84618,"endIdx":84720,"section":"Lead","locList":[{"start":84617,"end":84618},{"start":84621,"end":84640},{"start":84678,"end":84684},{"start":84688,"end":84719}]},{"md5":"3bfc6f2030839321f48a0168ed053732","id":80,"text":"In English, the word order of most noun phrases is that determiners, adjectives, and modifying nouns in respective order must appear before the head word, and relative clauses must appear after the head word.[3]","startIdx":84721,"endIdx":85110,"section":"Lead","locList":[{"start":84719,"end":84776},{"start":84822,"end":84833},{"start":84837,"end":84839},{"start":84883,"end":84893},{"start":84897,"end":85026},{"start":85088,"end":85099}]},{"md5":"7d768ce849961e9a59cb85925d8eb1c4","id":81,"text":"Nouns","startIdx":89670,"endIdx":89771,"section":"Lead","locList":[{"start":89669,"end":89670},{"start":89751,"end":89756}]}]