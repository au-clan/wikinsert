[{"md5":"0cf38328ae63f1cc4afb738bb2e029d5","id":0,"text":"Prospero and Ariel from a painting by William Hamilton","startIdx":253334,"endIdx":253593,"section":"Lead","locList":[{"start":253334,"end":253372},{"start":253551,"end":253567}]},{"md5":"b1313bf46003d26a785f8b839f0f81ed","id":1,"text":"The Tempest is one of William Shakespeare's last comedies.","startIdx":253594,"endIdx":253836,"section":"Lead","locList":[{"start":253593,"end":253594},{"start":253603,"end":253614},{"start":253622,"end":253633},{"start":253725,"end":253746},{"start":253750,"end":253756},{"start":253822,"end":253830},{"start":253834,"end":253835}]},{"md5":"1e41c5773866b545c7368836f21d8fd1","id":2,"text":"It tells the story of a wizard who drives a ship to the island he lives on, in order to undo something that happened to him in the past.","startIdx":253837,"endIdx":254043,"section":"Lead","locList":[{"start":253835,"end":253860},{"start":253926,"end":253932},{"start":253936,"end":254042}]},{"md5":"565e56f0aa61e1ec74392392a698f3f5","id":3,"text":"Unlike most of Shakespeare's plays, it does not appear to be based on an earlier story.","startIdx":254044,"endIdx":254131,"section":"Lead","locList":[{"start":254042,"end":254130}]},{"md5":"09405ba1ef477c2a88942a40f4652735","id":4,"text":"The play is set on an island where a magician called Prospero lives with his daughter Miranda.","startIdx":254230,"endIdx":254328,"section":"Lead","locList":[{"start":254229,"end":254230},{"start":254233,"end":254327}]},{"md5":"3afabd6531a150fb35c5f54c8537bcb6","id":5,"text":"The only company is Ariel, a spirit that Prospero rescued, and Caliban, a monster that Prospero has enslaved.","startIdx":254329,"endIdx":254438,"section":"Lead","locList":[{"start":254327,"end":254437}]},{"md5":"e79f803a0d71a637fa0baf9821389bf1","id":6,"text":"Prospero conjures a storm that drives a ship to the island.","startIdx":254439,"endIdx":254498,"section":"Lead","locList":[{"start":254437,"end":254497}]},{"md5":"c0d10ba1b5d6e4c748746621c9628771","id":7,"text":"Prospero explains to Miranda that there are men on board the ship who have done wrong against him.","startIdx":254499,"endIdx":254597,"section":"Lead","locList":[{"start":254497,"end":254596}]},{"md5":"3a9c4b01886792c7a2d2497af927b9a6","id":8,"text":"He used to be the Duke of Milan but was overthrown by his brother Antonio, with the help of Alonso, the King of Naples.","startIdx":254598,"endIdx":254717,"section":"Lead","locList":[{"start":254596,"end":254716}]},{"md5":"a0743334c94468791d3e36c2b0b5fac8","id":9,"text":"Prospero and Miranda were cast out to sea in a boat, which took them to the island.","startIdx":254718,"endIdx":254801,"section":"Lead","locList":[{"start":254716,"end":254800}]},{"md5":"ea9566679dba5ae3086babcb15362d14","id":10,"text":"Miranda was only a baby at the time, and can only remember living on the island.","startIdx":254802,"endIdx":254882,"section":"Lead","locList":[{"start":254800,"end":254881}]},{"md5":"2b34ef5ce79c567deb793b511e1198b6","id":11,"text":"The passengers of the ship escape onto the island and are separated into groups.","startIdx":254883,"endIdx":254970,"section":"Lead","locList":[{"start":254881,"end":254882},{"start":254889,"end":254969}]},{"md5":"5429d3dfbe89ec61663f48333e6596b9","id":12,"text":"Alonso and his son Ferdinand both think each other is dead.","startIdx":254971,"endIdx":255030,"section":"Lead","locList":[{"start":254969,"end":255029}]},{"md5":"0fe8090613b51558fc92004fa9df38f0","id":13,"text":"Alonso is left with his brother Sebastian, Antonio and his kindly advisor Gonzalo.","startIdx":255031,"endIdx":255113,"section":"Lead","locList":[{"start":255029,"end":255112}]},{"md5":"b36a59d29b5aa44000705a6b16970d0e","id":14,"text":"Ferdinand meets Miranda and falls in love.","startIdx":255114,"endIdx":255156,"section":"Lead","locList":[{"start":255112,"end":255155}]},{"md5":"b0f601035dad1c67034ecbe67aff4790","id":15,"text":"Prospero tests Ferdinand to see if he is worthy enough for his daughter, and decides that he is.","startIdx":255157,"endIdx":255253,"section":"Lead","locList":[{"start":255155,"end":255252}]},{"md5":"ada47a15c62654d0c849d3001fa78176","id":16,"text":"Antonio and Sebastian plot to kill Alonso and Gonzalo, but are stopped by Ariel.","startIdx":255254,"endIdx":255334,"section":"Lead","locList":[{"start":255252,"end":255333}]},{"md5":"b49385030897ad35616126b7cce2f578","id":17,"text":"Meanwhile, Caliban meets two servants, Trinculo and Stephano.","startIdx":255335,"endIdx":255396,"section":"Lead","locList":[{"start":255333,"end":255395}]},{"md5":"4a78e33757467188d7c2b43b5385b864","id":18,"text":"He persuades them to overthrow Prospero so that they can rule the island.","startIdx":255397,"endIdx":255470,"section":"Lead","locList":[{"start":255395,"end":255469}]},{"md5":"022ec319a0abeaeb01f89733e6a1f979","id":19,"text":"Prospero stops them by summoning goblins and hounds to chase them away.","startIdx":255471,"endIdx":255542,"section":"Lead","locList":[{"start":255469,"end":255541}]},{"md5":"39277101ba47a023fc0294b260a1d54f","id":20,"text":"Ariel transforms into a fearsome bird-like creature and confronts Antonio, Alonso and Sebastian, telling them they should be sorry for overthrowing Prospero.","startIdx":255543,"endIdx":255707,"section":"Lead","locList":[{"start":255541,"end":255542},{"start":255549,"end":255706}]},{"md5":"7be8684d37560bb83490a6d7d5df1bb5","id":21,"text":"They flee and eventually find Prospero.","startIdx":255708,"endIdx":255747,"section":"Lead","locList":[{"start":255706,"end":255746}]},{"md5":"d1cc1a42bd28222f3fb0afcc1017fa9f","id":22,"text":"He announces that he will forgive everyone who plotted against him (including Caliban), give up magic and return to Milan.","startIdx":255748,"endIdx":255870,"section":"Lead","locList":[{"start":255746,"end":255869}]},{"md5":"125a4c12d995a305a6f2fbb33f07f8fd","id":23,"text":"They react in different ways; Alonso is sorry for what he has done, while Antonio thinks the forgiveness is \"unnatural\".","startIdx":255871,"endIdx":255991,"section":"Lead","locList":[{"start":255869,"end":255990}]},{"md5":"8ef89ac05aaf8e3aca2814857c1c6c5f","id":24,"text":"It is revealed that the ship and all the passengers survived the \"shipwreck\".","startIdx":255992,"endIdx":256069,"section":"Lead","locList":[{"start":255990,"end":256068}]},{"md5":"c8472d277fe0eac79ed049c822decf23","id":25,"text":"Prospero sets Ariel free, and he and Miranda join everyone else in heading off back to Italy.","startIdx":256070,"endIdx":256163,"section":"Lead","locList":[{"start":256068,"end":256162}]},{"md5":"61b078ed8363a1b7b99e8563a901f58f","id":26,"text":"Prospero, the rightful Duke of Milan, who is a magician","startIdx":256247,"endIdx":256316,"section":"Lead","locList":[{"start":256246,"end":256247},{"start":256255,"end":256310}]},{"md5":"f910c97eb6471a8928a5f6c7b1c51e71","id":27,"text":"Miranda, Prospero's daughter","startIdx":256317,"endIdx":256354,"section":"Lead","locList":[{"start":256315,"end":256316},{"start":256320,"end":256348}]},{"md5":"0d2ddd938237d510d6cefec74ad41cb5","id":28,"text":"Ariel, an airy spirit who used to be a slave of Sycorax","startIdx":256355,"endIdx":256419,"section":"Lead","locList":[{"start":256353,"end":256354},{"start":256358,"end":256413}]},{"md5":"7831a62bf5dd5a72f21205b5c54519c9","id":29,"text":"Caliban, a savage and deformed slave","startIdx":256420,"endIdx":256465,"section":"Lead","locList":[{"start":256418,"end":256419},{"start":256423,"end":256459}]},{"md5":"4d910de88df03c9f21a97212ba01b1fc","id":30,"text":"Alonso, King of Naples","startIdx":256466,"endIdx":256497,"section":"Lead","locList":[{"start":256464,"end":256465},{"start":256469,"end":256491}]},{"md5":"f3ad9e76638702ca6ccffa7d70053181","id":31,"text":"Ferdinand, son of Alonso","startIdx":256498,"endIdx":256531,"section":"Lead","locList":[{"start":256496,"end":256497},{"start":256501,"end":256525}]},{"md5":"69ebf0f120496fa2339785755095d96c","id":32,"text":"Sebastian, Alonso's brother","startIdx":256532,"endIdx":256568,"section":"Lead","locList":[{"start":256530,"end":256531},{"start":256535,"end":256562}]},{"md5":"279e50515d988b1523612443d97b0399","id":33,"text":"Antonio, Prospero's brother, the usurping Duke of Milan","startIdx":256569,"endIdx":256633,"section":"Lead","locList":[{"start":256567,"end":256568},{"start":256572,"end":256627}]},{"md5":"837fe2bb66e0e826e4efa13b37d98783","id":34,"text":"Gonzalo, an honest old councillor","startIdx":256634,"endIdx":256676,"section":"Lead","locList":[{"start":256632,"end":256633},{"start":256637,"end":256670}]},{"md5":"a55dc2cfc0a41fe83b2bf268d18fa404","id":35,"text":"Adrian and Francisco, lords","startIdx":256677,"endIdx":256713,"section":"Lead","locList":[{"start":256675,"end":256676},{"start":256680,"end":256707}]},{"md5":"818333b73424366eb75dbaa8d79d93fe","id":36,"text":"Sycorax (unseen), a deceased sorceress and mother of Caliban, who was banished to the island before Prospero arrived and enslaved the spirits on the island, including Ariel.","startIdx":256714,"endIdx":256901,"section":"Lead","locList":[{"start":256712,"end":256713},{"start":256717,"end":256890}]},{"md5":"c11405431c564cafb66d8f926f16f34c","id":37,"text":"The 1956 science fiction film Forbidden Planet set the story on a planet in space, Altair IV, instead of an island.","startIdx":257012,"endIdx":257316,"section":"Lead","locList":[{"start":257011,"end":257012},{"start":257015,"end":257024},{"start":257108,"end":257123},{"start":257127,"end":257133},{"start":257222,"end":257238},{"start":257246,"end":257315}]},{"md5":"fc3421f1b0b4a4e1970e6f19d774dcaf","id":38,"text":"Professor Morbius (Walter Pidgeon) and his daughter Altaira (Anne Francis) are the Prospero and Miranda figures (both Prospero and Morbius having harnessed the mighty forces that inhabit their new homes).","startIdx":257317,"endIdx":257696,"section":"Lead","locList":[{"start":257315,"end":257316},{"start":257323,"end":257342},{"start":257424,"end":257438},{"start":257442,"end":257470},{"start":257548,"end":257560},{"start":257564,"end":257695}]},{"md5":"0484214a7d83556a943adbf8268a1b85","id":39,"text":"Ariel is represented by the helpful Robbie the Robot, while Sycorax is replaced with the powerful race of the Krell.","startIdx":257697,"endIdx":257976,"section":"Lead","locList":[{"start":257695,"end":257732},{"start":257891,"end":257907},{"start":257911,"end":257975}]},{"md5":"735453bd80614cd9d4e8b7fef2547751","id":40,"text":"Caliban is represented by the dangerous and invisible \"monster from the id\", a projection of Morbius' psyche born from the Krell technology instead of Sycorax's womb.[1]","startIdx":257977,"endIdx":258466,"section":"Lead","locList":[{"start":257975,"end":258048},{"start":258126,"end":258128},{"start":258132,"end":258160},{"start":258246,"end":258252},{"start":258256,"end":258314},{"start":258452,"end":258455}]},{"md5":"722f313e5e3869198cf56efc7ce9ab64","id":41,"text":"The \"tempest\" - a word meaning \"storm\" - is in the first scene of the play, and wrecks a ship.","startIdx":258548,"endIdx":259502,"section":"Lead","locList":[{"start":258547,"end":258548},{"start":259385,"end":259479}]},{"md5":"6dd639277e91f2f6663ca87ea92fcec1","id":42,"text":"Shakespeare's The Tempest: The Wise Man as Hero","startIdx":259503,"endIdx":259651,"section":"Lead","locList":[{"start":259501,"end":259502},{"start":259594,"end":259641}]},{"md5":"e9140cfc7d52ccc1640f30cdbc903367","id":43,"text":"The Theme of Natural Order in \"The Tempest\"","startIdx":259652,"endIdx":259791,"section":"Lead","locList":[{"start":259650,"end":259651},{"start":259738,"end":259781}]},{"md5":"fd378b005b051c6e9a985924dd17cac9","id":44,"text":"Form and Disorder in The Tempest","startIdx":259792,"endIdx":259921,"section":"Lead","locList":[{"start":259790,"end":259791},{"start":259879,"end":259911}]},{"md5":"51fadd0d0a7c1a54b5e238cdbcde30a9","id":45,"text":"The Magic of Charity: A Background to Prospero","startIdx":259922,"endIdx":260064,"section":"Lead","locList":[{"start":259920,"end":259921},{"start":260008,"end":260054}]},{"md5":"94afbe3eb6f114efa87e223a8a8a96db","id":46,"text":"The Tempest Archived 2004-10-14 at the Wayback Machine - plain vanilla text from Project Gutenberg","startIdx":260065,"endIdx":260569,"section":"Lead","locList":[{"start":260063,"end":260064},{"start":260151,"end":260162},{"start":260166,"end":260167},{"start":260293,"end":260301},{"start":260305,"end":260324},{"start":260408,"end":260423},{"start":260427,"end":260454},{"start":260542,"end":260559}]},{"md5":"d504555d0138850a397800467de37658","id":47,"text":"The Tempest Archived 2008-08-28 at the Wayback Machine - scene indexed, online version of the play.","startIdx":260570,"endIdx":260985,"section":"Lead","locList":[{"start":260568,"end":260569},{"start":260657,"end":260668},{"start":260672,"end":260673},{"start":260800,"end":260808},{"start":260812,"end":260831},{"start":260915,"end":260930},{"start":260934,"end":260979}]},{"md5":"cb409316c3f929b0351ec4704f198131","id":48,"text":"The Tempest - HTML version of this title.","startIdx":260986,"endIdx":261152,"section":"Lead","locList":[{"start":260984,"end":260985},{"start":261101,"end":261112},{"start":261116,"end":261146}]},{"md5":"05a9924cdf54e32381183db01972dde1","id":49,"text":"Bermoothes in E. Cobham Brewer's Dictionary of Phrase and Fable (1898).","startIdx":261153,"endIdx":261321,"section":"Lead","locList":[{"start":261151,"end":261152},{"start":261240,"end":261250},{"start":261254,"end":261315}]},{"md5":"48ae7b05ec0b635201d4c246011bf3d5","id":50,"text":"Lesson plans for The Tempest Archived 2007-06-29 at the Wayback Machine at Web English Teacher","startIdx":261322,"endIdx":261746,"section":"Lead","locList":[{"start":261320,"end":261321},{"start":261414,"end":261442},{"start":261446,"end":261447},{"start":261583,"end":261591},{"start":261595,"end":261614},{"start":261698,"end":261713},{"start":261717,"end":261740}]},{"md5":"ca4921197f74670f6807193f131ccf85","id":51,"text":"William Strachey's \"True Reportory\" original-spelling version at Virtual Jamestown.","startIdx":261747,"endIdx":261945,"section":"Lead","locList":[{"start":261745,"end":261746},{"start":261847,"end":261908},{"start":261912,"end":261934}]},{"md5":"47322b3405d806e65a54831bc0b612db","id":52,"text":" This short article about the&nbsp;performing arts can be made longer.","startIdx":305001,"endIdx":305850,"section":"Lead","locList":[{"start":305000,"end":305001},{"start":305572,"end":305573},{"start":305576,"end":305581},{"start":305663,"end":305676},{"start":305680,"end":305696},{"start":305810,"end":305825},{"start":305829,"end":305849}]},{"md5":"f3dc23d05e80a7de704ac93c38fbd892","id":53,"text":"You can help Wikipedia by adding to it.","startIdx":305851,"endIdx":306011,"section":"Lead","locList":[{"start":305849,"end":305876},{"start":305983,"end":305995},{"start":306003,"end":306004}]},{"md5":"888b7a64998128787499c09c4623966d","id":54,"text":" This short article about literature can be made longer.","startIdx":306038,"endIdx":306858,"section":"Lead","locList":[{"start":306037,"end":306038},{"start":306604,"end":306605},{"start":306608,"end":306613},{"start":306695,"end":306708},{"start":306712,"end":306719},{"start":306823,"end":306833},{"start":306837,"end":306857}]},{"md5":"f3dc23d05e80a7de704ac93c38fbd892","id":55,"text":"You can help Wikipedia by adding to it.","startIdx":306859,"endIdx":307019,"section":"Lead","locList":[{"start":306857,"end":306884},{"start":306991,"end":307003},{"start":307011,"end":307012}]}]